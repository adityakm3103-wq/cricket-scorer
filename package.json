{
  "name": "cricket-scorer-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:backend": "cd backend && npm.cmd run dev",
    "start:frontend": "cd frontend && npm.cmd run dev",
    "test:backend": "cd backend && npm.cmd test",
    "build:backend": "cd backend && npm.cmd run build",
    "build:frontend": "cd frontend && npm.cmd run build",
    "seed": "cd backend && npx.cmd tsx src/seed.ts",
    "cap": "cd frontend && npx.cmd cap",
    "cap:sync": "cd frontend && npx.cmd cap sync",
